---
  metadata: {
    partial_name: "search-result-faqs"
  }
---
<div class="blocks-sc-1col-06 wrapper bg-color-ui-01">
  <div class="spacer xxxx-large"></div>
  <div class="grid-container">
    <div class="grid-x gutter grid-padding-x align-center">
      <div class="large-9 medium-12 small-12 cell">
        <h2>FAQs</h2>
        <div class="spacer x-large"></div>
        {%- assign page = context.params.fp | default: 1 | plus: 0 -%}
        {%- assign per_page = context.params.per_page | default: 5 | plus: 0 -%}

        {%- if faq_search_results.results.size == 0 -%}
        <!-- No results -->
        {%- if category != blank -%}
        <p>No results found for {{ category }}.</p>
        {%- else -%}
        <p>No results found within FAQs.</p>
        {%- endif -%}
        <!-- End no results -->
        {%- else -%}
        <!-- Has results -->
        <div class="faqs-holder">
          <ins-accordion>
            {%- for faq in faq_search_results.results -%}
            <ins-accordion-item heading="{{ faq.question }}">
              <ins-markdown
                value="{{ faq.answer }}">
              </ins-markdown>
              {%- if faq.attachment_download.url -%}
              <div class="spacer small"></div>
              <hr />
              <div class="spacer small"></div>
              <div class="grid-x grid-padding-x container">
                <div class="small-7 medium-6 large-9 cell">
                  {{ faq.attachment_label }}
                </div>
                <div class="small-5 medium-6 large-3 cell text-right">
                  <a href="{{ faq.attachment_download.url}}" target="_blank">
                    <ins-button icon="icon-file-download" label="DOWNLOAD" solid size="small">
                    </ins-button>
                  </a>
                </div>
              </div>
              {%- endif -%}
            </ins-accordion-item>
            {%- endfor -%}
          </ins-accordion>
        </div>
        <!-- pagination -->
        <div class="spacer xxxx-large"></div>
        <div class="pagination-holder">
          {%- include 'modules/intranet/content/pagination/category_pagination',
          data: faq_search_results,
          per_page: per_page,
          type: "search_faqs" -%}
        </div>
        <!-- /pagination -->
        <!-- End has results -->
        {%- endif -%}

      </div>
    </div>
  </div>
</div>