---
  metadata: {
    partial_name: "search-result-news"
  }
---
<div class="blocks-sc-1col-05 wrapper bg-color-ui-01 results-news">
  <div class="spacer xxxx-large"></div>
  <div class="grid-container">
    <div class="grid-x gutter grid-padding-x align-center">
      <div class="large-9 medium-12 small-12 cell">
        <h2>Company News</h2>
        <div class="spacer x-large"></div>
        <div class="articles-container">

          {%- assign page = context.params.ap | default: 1 | plus: 0 -%}
          {%- assign per_page = context.params.per_page | default: 5 | plus: 0 -%}

          {%- if news_search_result.results.size == 0 -%}
          <!-- No results -->
          {%- if category != blank -%}
          <p>No results found for {{ category }}.</p>
          {%- else -%}
          <p>No results found within News.</p>
          {%- endif -%}
          <!-- End no results -->
          {%- else -%}
          <!-- Has results -->

          {%- for news in news_search_result.results -%}
          <!-- article -->

          <div class="article-item">
            <p class="subhead-2 cat-section">{{ news.category }}</p>
            <div class="spacer small"></div>
            <a href="news/{{ news.slug }}">
              <h3>{{ news.post_title }}
              </h3>
            </a>
            <div class="spacer small"></div>
            <div class="publish-info">{{ news.short_text }}
            </div>
            <div class="spacer"></div>
            <a href="news/{{ news.slug }}" class="button-default color-main">Read More</a>
          </div>
          <!-- /article -->
          {%- endfor -%}
          <!-- pagination -->
          <div class="spacer xxxx-large"></div>
          <div class="pagination-holder">
            {%- include 'modules/intranet/content/pagination/category_pagination',
            data: news_search_result,
            per_page: per_page,
            type: "search_news" -%}
          </div>
          <!-- /pagination -->
          <!-- End has results -->
          {%- endif -%}
        </div>




      </div>
    </div>
  </div>
</div>