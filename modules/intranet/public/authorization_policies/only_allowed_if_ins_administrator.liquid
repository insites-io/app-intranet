---
name: only_allowed_if_ins_administrator
redirect_to: 401
flash_alert: Please login as administrator to access this page.
metadata: {
    "auth_policy_key": "only_allowed_if_ins_administrator",
    "auth_policy_name": "only_allowed_if_ins_administrator"
}
---

{% graphql data = 'modules/intranet/session/get_current_user' %}

{% assign admin = data.current_user.administrator_details %}

{% if admin and admin.size > 0 %}
  {% assign admin_status = admin | first | dig: 'status' %}
  {% if admin_status and admin_status == 'active' %}
    true
  {% endif %}
{% endif %}

