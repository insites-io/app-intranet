---
  metadata: {
    layout_name: "system_layout"
  }
---

{%- include "modules/intranet/data/global_content" -%}
{%- assign global = context.exports.global -%}

<!DOCTYPE html>
<html lang="en">
    <head>
        {% include 'modules/intranet/layout/technical_head' %}
    </head>
    <body class="system-page flex-container flex-dir-column">
        
    {%- graphql data = 'modules/intranet/session/get_current_user' -%}
    {%- if data.current_user.administrator_details[0].is_enabled == true or data.current_user.administrator_details[0].is_enabled == "true" -%}
        {%- assign valid_session = true -%}
    {%- endif -%}
    {%- if valid_session -%}
        {%- include 'modules/intranet/layout/header' -%}
    {%- endif -%}
        
        <div class="system-content">
            {{ content_for_layout }}
        </div>
        
    {%- if valid_session -%}
        {%- include 'modules/intranet/layout/footer' -%}
    {%- endif -%}
    </body>
</html>