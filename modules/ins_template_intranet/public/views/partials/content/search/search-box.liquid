<div class="blocks-hero-04 wrapper" style="background-image: url('{{ 'modules/ins_template_intranet/images/bg-dark-optimized.jpeg' | asset_url }}');">
  <div class="grid-container">
    <div class="spacer xxxx-large"></div>
    <div class="grid-x align-center">
      <div class="large-6 medium-10 small-12 cell">
        <div class="title">
          {%- if context.params.keyword and context.params.keyword != "" -%}
          Search Results for {{ context.params.keyword | truncate: 100, " ..." }}
          {%- else -%}
          Insites Intranet
          {%- endif -%}
        </div>
        <div class="spacer large"></div>
        <ins-input id="homepage-search" placeholder="Search" value="" icon="icon-search">
        </ins-input>
      </div>
    </div>
    <div class="spacer xxxx-large"></div>
  </div>
</div>

<script>
  let homepageSearch = document.getElementById('homepage-search');
  if (homepageSearch) {
    homepageSearch.addEventListener('insInput', searchHandler);
    homepageSearch.addEventListener('insIconClick', event => searchHandler(event, true))
  }

  function searchHandler(event, click = false) {
    if ((event.detail.keyCode === 13 && event.detail.value !== "") ||
      (click && event.detail.value !== "")) {
      window.location = `/search?keyword=${encodeURIComponent(event.detail.value)}`;
    } else if (event.detail.value == "") {
      window.location = `/`;
    }
  }

</script>