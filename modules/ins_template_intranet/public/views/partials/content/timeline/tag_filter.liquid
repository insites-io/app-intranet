{%- graphql res = "modules/ins_template_intranet/timeline/get_schema_metadata" -%}

{%- assign props = res.items.results.first.properties -%}

{% for prop in props %}

    {%- if prop.name == "category_tag" -%}
        {%- assign options = "All" | split: ',' -%}
        {%- assign options = options | add_to_array: prop.metadata.values | flatten -%}
        {%- assign tag = context.params.tag | default: "" -%}
        {%- assign has_category = options | any: category -%}

        {%- if tag == "All" or has_category == false -%}
            {%- assign category =  "" -%}
        {%- endif -%}

        {%- export tag, namespace: 'filters' -%}

        <ins-filter-item
            name="Tag" selected="{{ tag }}"
            options='{{ options }}'>
        </ins-filter-item>
        {%- break -%}
        
    {%- endif -%}
{% endfor %}