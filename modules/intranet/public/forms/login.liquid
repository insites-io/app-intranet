---
name: login
resource: Session
resource_owner: anyone
flash_notice: 'Successful'
flash_alert: 'Alert-SignIn'
redirect_to: /
fields:
  email:
    validation: 
      presence: true
      email: 
  password:
    validation: 
      presence: true
callback_actions: |
  {%log form, type: "====admin_sign_in form====" %}
---
<div class="text-center">
    <h2>This page is password protected</h2>
    <div class="spacer x-small"></div>
    <p>Enter the password below to view.</p>
    <div class="spacer large"></div>
</div>

{%- form 
	html-id: "adminSignIn"
    html-enctype="multipart/form-data" -%}

    <pre id="adminSignInFormConfig" style="display: none">
        {{form | json}}
    </pre>

    <div class="grid-x">
      <div class="large-12 cell">
        <ins-input validate
            class="string email required"
            id="email"
            label="Email"
            field="email"
            name="{{ form.fields.email.name }}" 
            value="{{ form.fields.email.value }}" 
            {% if form.errors['email'] %} has-error {% endif %}
            error-message="{{ form.fields.email.validation.rules.presence.message }}"
            placeholder="Email">
        </ins-input>
      </div>
      <div class="large-12 cell">
        <ins-input validate
            class="password required"
            id="password"
            label="Password"
            field="password"
            name="{{ form.fields.password.name }}" 
            value="{{ form.fields.password.value }}" 
            {% if form.errors['password'] %} has-error {% endif %}
            error-message="{{ form.fields.password.validation.rules.presence.message }}"
            placeholder="Password">
      </ins-input>
      </div>

      <div class="large-12 cell">
        <div class="text-center">
            <ins-button type="submit" label="Enter" id="submitButton" solid size="large" class="full-btn" color="pink"></ins-button>
        </div>
        <div class="spacer x-small"></div>
        {%- if context.flash.alert == 'Alert-SignIn' -%}
            <div class="error-submit-sign-in error-message">Oops! That email / password combination is not valid.</div>
        {% endif %}
      </div>
    </div>
{%- endform -%}

<style>
    .error-submit-sign-in { 
        font-size: 14px;
    }
    .login-page img {
        margin: 0 auto;
        max-width: 228px;
        width: 100%;
    }
    @media screen and (max-width: 639px) {
        .login-page img {
            max-width: 200px;
        }
    }
    .login-wrap {
        background: #FFFFFF;
        padding: 40px;
        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.25);
        border-radius: 8px;
    }
    .full-btn button {
        width: 100%;
    }
    @media screen and (max-width: 1024px) {
        .login-wrap { padding: 24px; }
    }

    .wrapper {
        margin: 0 auto;
        padding-top: 0;
        padding-bottom: 0;
        padding-left: var(--container-padding-xx-large, 24px);
        padding-right: var(--container-padding-xx-large, 24px);
    }
    .wrapper, .grid-container {
        max-width: var(--container-max-width, 1232px);
        position: relative;
        padding-left: 0;
        padding-right: 0;
    }
    .wrapper .wrapper {
        padding-left: 0;
        padding-right: 0;
    }

    @media screen and (min-width: 1440px) {
        .wrapper {
            padding-left: var(--container-padding-xx-large, 24px);
            padding-right: var(--container-padding-xx-large, 24px);
        }
    }

    @media screen and (min-width: 1200px) and (max-width: 1439px) {
        .wrapper {
            padding-left: var(--container-padding-x-large, 24px);
            padding-right: var(--container-padding-x-large, 24px);
        }
    }

    @media screen and (min-width: 1024px) and (max-width: 1199px) {
        .wrapper {
            padding-left: var(--container-padding-large, 24px);
            padding-right: var(--container-padding-large, 24px);
        }
    }


    @media screen and (min-width: 640px) and (max-width: 1023px) {
        .wrapper {
            padding-left: var(--container-padding-medium, 32px);
            padding-right: var(--container-padding-medium, 32px);
        }

    }

    @media screen and (max-width: 639px) {
        .wrapper {
            padding-left: var(--container-padding-small, 24px);
            padding-right: var(--container-padding-small, 24px);
        }
        .spacer.section { padding-bottom: 80px; }
        .spacer.xxx-large,
        .spacer.xxxx-large { padding-bottom: 40px; }
    }
</style>