---
  metadata: {
    partial_name: "footer-linkset-medium"
  }
---
<div class="grid-x grid-padding-x gutter-medium show-for-medium-only">
  <div class="medium-12 small-12 cell">
    <!-- 6 set -->
    <div class="grid-x">
      <div class="medium-3">
        <!-- link set -->
        <ul class="vertical menu">
          <li>
            <a class="navigation-level-1 color-font-head">Marketing</a>
            <div class="spacer"></div>
          </li>
          {%- for footer_marketing_item in footer_marketing_items -%}
          {%- if footer_marketing_item.parent_category == null -%}
          <li>
            <a href="/marketing/{{ footer_marketing_item.slug }}" class="footer-links color-font-head">{{
              footer_marketing_item.title }}</a>
            <div class="spacer x-small"></div>
          </li>
          {%- endif -%}
          {%- endfor -%}
        </ul>
        <!-- /link set -->
      </div>
      <div class="medium-3">
        <!-- link set -->
        <ul class="vertical menu">
          <li>
            <a class="navigation-level-1 color-font-head">Support</a>
