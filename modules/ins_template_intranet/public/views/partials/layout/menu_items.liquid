{%- graphql location_1 = 'modules/ins_template_intranet/system/get_database_content_for_menu'
database_name: 'modules/ins_template_intranet/location_1'
-%}
{%- graphql location_2 = 'modules/ins_template_intranet/system/get_database_content_for_menu'
database_name: 'modules/ins_template_intranet/location_2'
-%}

{%- assign location_1_items = location_1.items.results -%}
{%- assign location_2_items = location_2.items.results -%}


<ul class="main-menu show-for-large">
  <li>
    <ins-dropdown label="Teams" link-title="teams">
      <ins-dropdown-item label="Support"
        link="/support">
      </ins-dropdown-item>
      <ins-dropdown-item label="Sales"
        link="/sales">
      </ins-dropdown-item>
      <ins-dropdown-item label="Developers"
        link="/developers">
      </ins-dropdown-item>
      <ins-dropdown-item label="Delivery"
        link="/delivery">
      </ins-dropdown-item>
      <ins-dropdown-item label="Design"
        link="/design">        
      </ins-dropdown-item>
      <ins-dropdown-item label="Marketing"
        link="/marketing">        
      </ins-dropdown-item>
    </ins-dropdown>
  </li>
  <li>
    <ins-dropdown label="Location 1" link="/location-1" link-title="Location 1">
      {%- for location_1_item in location_1_items -%}
      {%- if location_1_item.parent_category == null -%}
      <ins-dropdown-item label="{{- location_1_item.title-}}"
        link="/location-1/{{- location_1_item.slug -}}">
      </ins-dropdown-item>
      {%- endif -%}
      {%- endfor -%}
    </ins-dropdown>
  </li>
  <li>
    <ins-dropdown label="Location 2" link="/location-2" link-title="Location 2" class="loc-2-dropdown">
      {%- for location_2_item in location_2_items -%}
      {%- if location_2_item.parent_category == null -%}
      <ins-dropdown-item label="{{- location_2_item.title-}}"
        link="/location-2/{{- location_2_item.slug -}}">
      </ins-dropdown-item>
      {%- endif -%}
      {%- endfor -%}
    </ins-dropdown>
  </li>
  <li {% if context.params.slug=='news' %}class="active" {%- endif -%}>
    <a href="/news">
      News
    </a>
  </li>
  <li {% if context.params.slug=='faqs' %}class="active" {%- endif -%}>
    <a href="/faqs">
      FAQs
    </a>
  </li>
  <li {% if context.params.slug=='timeline' %}class="active" {%- endif -%}>
    <a href="/timeline">
      Timeline
    </a>
  </li>
</ul>