---
slug: search
layout: modules/ins_template_intranet/home_layout
# enable_profiler: true
searchable: true
max_deep_level: 1
metadata: {
  page_name: "Insites Template Intranet | Search",
  page_type: "content",
  page_title: "Insites Template Intranet | Search",
  meta_title: "Insites Template Intranet | Search",
  status: "published",
  canonical_url: "",
  open_graph_url: "",
  open_graph_type: "",
  meta_description: "The Insites platform allows you to create world class web applications using elements through a
  complete design and development eco-system.",
  open_graph_title: "Insites Template Intranet | Search",
  open_graph_site_name: "",
  open_graph_description: "The Insites platform allows you to create world class web applications using elements through a
  complete design and development eco-system.",
  sitemap_priority: 1.0, 
  sitemap_order: 0, 
  sitemap_change_frequency: "monthly",
  is_visible_to_search_engines: true,
  is_auth_policy_enabled: true,
  is_sitemap_enabled: true
}
authorization_policies:
  - modules/ins_template_intranet/only_allowed_if_logged_in
  - modules/ins_template_intranet/only_allowed_if_ins_administrator
enable_profiler: true
dynamic_cache:
  layout: |-   
    true
  key: |-
    {%- parse_json models -%}
    [
      "modules/insites_cms/insites_global_content",
      "modules/insites_core/crm_system_field",
      "modules/ins_template_intranet/design",
      "modules/ins_template_intranet/developers",
      "modules/ins_template_intranet/support"
    ]
    {%- endparse_json -%}
    {%- include "modules/ins_template_intranet/system/generate_cache_key", models: models -%}
---
{%- assign keyword = context.params.keyword -%}
{%- assign faq_page = context.params.fp | default: 1 | plus: 0 -%}
{%- assign news_page = context.params.ap | default: 1 | plus: 0 -%}

{%- assign documentation_page = context.params.dp | default: 1 | plus: 0 -%}
{%- assign docu_category = context.params.docu_category -%}

{%- assign search_per_page = context.params.per_page | default: 5 | plus: 0 -%}

{%- graphql faq_search_result = 'modules/ins_template_intranet/search/search_keyword_faqs' 
    schema: 'modules/ins_template_intranet/faqs', 
    keyword: keyword, 
    page: faq_page,
    size: search_per_page
    status: "Published"
-%}

{%- if docu_category and docu_category != ""  -%}
  {%- comment -%} Search Specific Docu Database {%- endcomment -%}
  {%- assign docu_specific_db = docu_category | replace: "-", "_" -%}
  {%- assign database_schema = "modules/ins_template_intranet/" | append: docu_specific_db -%}

  {%- graphql documentation_search_result = 'modules/ins_template_intranet/search/search_keyword_documentation' 
    schema: database_schema, 
    keyword: keyword, 
    page: documentation_page,
    size: search_per_page
    status: "Published"
  -%}

  {%- assign documentation_items = documentation_search_result.items -%}
  {%- comment -%} End Search Specific Docu Database {%- endcomment -%}
{%- else -%}
  {%- comment -%} Search All Docu Database {%- endcomment -%}
  {%- graphql documentation_search_result = 'modules/ins_template_intranet/search/search_all_documentation' 
    keyword: keyword, 
    page: documentation_page,
    size: search_per_page
    status: "Published"
  -%}

  {%- assign documentation_items = documentation_search_result.records -%}
  {%- comment -%} End Search All Docu Database {%- endcomment -%}
{%- endif -%}

{%- graphql news_search_result = 'modules/ins_template_intranet/search/search_keyword_news' 
    schema: 'modules/ins_template_intranet/news', 
    keyword: keyword, 
    page: news_page,
    size: search_per_page
    status: "Published"
-%}

<div class="app-wrap main-container search-results">
  {% include 'modules/ins_template_intranet/content/search/search-box' %}

  {% include 'modules/ins_template_intranet/content/search/search-result-faqs',
  faq_search_results: faq_search_result.records %}
  
  {% include 'modules/ins_template_intranet/content/search/search-result-documentation', 
  documentation_search_result: documentation_items %}
  
  {% include 'modules/ins_template_intranet/content/search/search-result-news', 
  news_search_result: news_search_result.items %}
  <div class="spacer xxxx-large"></div>
</div>