---
  metadata: {
    partial_name: "footer"
  }
---
{%- graphql footer_design = 'modules/ins_template_intranet/system/get_footer_links'
database_name: 'modules/ins_template_intranet/design',
properties: filter
-%}

{%- graphql footer_support = 'modules/ins_template_intranet/system/get_footer_links'
database_name: 'modules/ins_template_intranet/support',
properties: filter
-%}

{%- graphql footer_developers= 'modules/ins_template_intranet/system/get_footer_links'
database_name: 'modules/ins_template_intranet/developers',
properties: filter
-%}

{%- assign footer_design_items = footer_design.items.results -%}
{%- assign footer_support_items = footer_support.items.results -%}
{%- assign footer_developers_items = footer_developers.items.results -%}

<footer class="blocks-footer-04 footer bg-color-ui-01">
  <hr>
  <div class="wrapper">
    <div class="grid-container">
      <div class="spacer xxxx-large"></div>
      <!-- footer linkset large -->
      {% include 'modules/ins_template_intranet/layout/footer/footer-linkset-large' %}
      <!-- /footer linkset large -->

      <!-- footer linkset medium -->
      {% include 'modules/ins_template_intranet/layout/footer/footer-linkset-medium' %}
      <!-- /footer linkset medium -->

      <!-- footer linkset small -->
      {% include 'modules/ins_template_intranet/layout/footer/footer-linkset-small' %}
      <!-- /footer linkset small -->
      <div class="spacer xxxx-large"></div>
    </div>
  </div>

  <div class="bg-color-main">
    <div class="wrapper">
      <div class="grid-container">
        <div class="spacer small"></div>
        <div class="bottom-footer grid-x align-middle body-small">
          <div class="large-6 medium-shrink small-12 cell">
            <div class="text-center no-bullet inline-list show-for-small-only">
              <div><a href="/privacy-policy">Privacy Policy</a></div>
              <div class="spacer small"></div>
              <div><a href="/terms-and-conditions" data-test="footer-link-mobile-privacy-policy">Terms and Conditions</a></div>
            </div>
            <ul class="no-bullet inline-list show-for-medium">
              <li><a href="/privacy-policy">Privacy Policy</a></li>
              <li><a href="/terms-and-conditions" data-test="footer-link-privacy-policy">Terms and Conditions</a></li>
            </ul>
          </div>
          <div class="large-6 medium-auto small-12 cell medium-text-right text-center">
            <div class="spacer large show-for-small-only"></div>
            <p class="copyright body-small">Copyright © 2024. Powered by <a href="https://www.insites.io/" target="_blank"
                data-test="footer-link-insites">Insites</a>.
            </p>
          </div>
        </div>
        <div class="spacer small"></div>
      </div>
    </div>
  </div>
</footer>