---
  metadata: {
    partial_name: "timeline-filter"
  }
---
{%- assign date_from = "" -%}
{%- assign date_to = "" -%}
{%- assign period = context.params.period | default: "" -%}
{%- assign range = context.params.range | default: "" -%}

{%- if range != "" and range != "All" -%}
{%- assign dates = range | split: ',' -%}
{%- if dates.size == 2 -%}
{%- assign date_from = dates[0] -%}
{%- assign date_to = dates[1] -%}

{%- assign range = '{}' | parse_json -%}
{%- assign range = range | add_hash_key: "gte", date_from -%}
{%- assign range = range | add_hash_key: "lte", date_to -%}
{%- endif -%}

{%- else -%}
{%- assign date_today = "now" | date: "%Y-%m-%d" -%}
{%- assign range = '{}' | parse_json -%}
{%- assign range = range | add_hash_key: "lte", date_today -%}
{%- endif -%}

{%- export range, namespace: 'filters' -%}

<span class="filter-label">Filters:</span>
<ins-filter id="tagFilter">
  {% include 'modules/intranet/content/timeline/tag_filter' %}
</ins-filter>

<ins-filter id="statusFilter">
  {% include 'modules/intranet/content/timeline/status_filter' %}
</ins-filter>

<ins-filter id="dateFilter" with-date-filter date-title="Date Period" date-from="{{ date_from }}"
  date-to="{{ date_to }}" default-date="{{ period }}">
</ins-filter>