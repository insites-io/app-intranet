---
  metadata: {
    partial_name: "documentation-list-holder"
  }
---
{%- assign page = context.params.page | default: 1 | plus: 0 -%}
{%- assign per_page = context.params.per_page | default: 9 | plus: 0 -%}

{% assign page_slug = context.params.slug %}

{%- assign list_view_schema_name = page_slug | downcase | replace: " ", "_" -%}
{%- assign list_view_schema_name = list_view_schema_name | replace: "-", "_" -%}

{%- assign list_view_database_schema = "modules/ins_template_intranet/" | append: list_view_schema_name -%}

{%- graphql documentation_list_items = 'modules/ins_template_intranet/documentation/get_documentation_list',
database_schema: list_view_database_schema
page: page,
size: per_page,
status: "Published"
-%}

<div class="blocks-sc-2col-04 wrapper bg-color-ui-01">
  <div class="grid-container">
    <div class="grid-x grid-padding-x gutter-medium blog-list align-middle" id="dynamic-content-wrapper">
      <div class="large-12 cell">
        <h1>{{ context.params.slug | replace: "-", " " | capitalize }}</h1>
        {% for docu_items in documentation_list_items.items.results %}
        <!-- docu list -->
        <div class="items">

          <div class="spacer large"></div>
          <p class="category subhead-2">{{ docu_items.section }}</p>
          <div class="spacer small"></div>
          <h3 class="title">
            <a href="/{{ context.params.slug }}/{{ docu_items.slug }}">{{ docu_items.title }}</a>
          </h3>
          <div class="spacer x-small"></div>
          <p class="published_date">{{ docu_items.published_date | strftime: '%b %d, %Y', 'Sydney' }}</p>
          <div class="spacer large"></div>
          <hr />
        </div>
        <!-- /docu list -->
        {% endfor %}

        <!-- pagination -->
        <div class="pagination-holder">
          {%- include 'modules/ins_template_intranet/content/documentation/pagination',
          data: documentation_list_items -%}
        </div>
        <!-- /pagination -->

      </div>
      <div class="spacer xxxx-large"></div>
    </div>
  </div>
</div>

<script>
  let per_page = {{ per_page }};
  let page_slug = '{{ page_slug }}';

  let goToFilteredUrl = function (per_page) {
    let url = `/${page_slug}` + `?page=1&per_page=${per_page}`;

    window.location.assign(url);
  }



  let pageSizeSelect = document.getElementById("documentation-page-size-select");
  if (pageSizeSelect) {
    pageSizeSelect.addEventListener('insValueChange', pageSizeValueSelected);
  }

  function pageSizeValueSelected(event) {
    let per_page = event.detail;
    goToFilteredUrl(per_page);
  }

</script>