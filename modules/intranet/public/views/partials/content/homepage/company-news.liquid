---
  metadata: {
    partial_name: "company-news"
  }
---
{% graphql news_preview = "modules/intranet/news/get_news", size: 3 %}
{%- assign news_preview_list = news_preview.items.results -%}

<div class="blocks-sc-3col-05 wrapper bg-color-ui-01 company-news">
  <div class="spacer xxxx-large"></div>
  <div class="grid-container">
    <div class="grid-x">
      <div class="small-12 cell text-center">
        <h2>Recent Company News</h2>
        <div class="spacer xxx-large"></div>
      </div>
    </div>
    <div class="grid-x gutter-medium grid-padding-x grid-padding-y">

      {%- for news_preview in news_preview_list -%}
      <!-- item -->
      <div class="large-4 medium-6 small-12 cell">
        <div class="">
          <div class="image">
            <a href="/news/{{ news_preview.slug }}?refer=homepage">
              <img src="{{ news_preview.image.url | replace: ' ', '%20' }}" alt="News Image">
            </a>
          </div>
          <div class="spacer"></div>
          <div class="title">
            <a class="color-font-head" href="/news/{{ news_preview.slug }}">
              <h3>
                {{ news_preview.post_title }}
              </h3>
            </a>
          </div>
          <div class="spacer"></div>
          <div class="short-description">
            <p class="font-grey">
              {{ news_preview.short_text }}
            </p>
          </div>
          <div class="spacer"></div>
          <a class="button-default read-more-btn" href="/news/{{ news_preview.slug }}">
            Read More &nbsp;<i class="icon-angle-right"></i>
          </a>
        </div>
      </div>
      <!-- /item -->
      {%- endfor -%}

    </div>
  </div>
  <div class="spacer xxxx-large"></div>
</div>

<style>
    .image img {
        width: 100%; 
        height: auto; 
        display: block;
    }
</style>