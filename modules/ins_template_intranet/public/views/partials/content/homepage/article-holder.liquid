{%- graphql homepage_timeline = 'modules/ins_template_intranet/timeline/get_timeline_items' 
    page: 1,
    size: 5
-%}

{%- if homepage_timeline.items.total_entries != 0-%}
{%- assign homepage_timeline = homepage_timeline.items.results -%}

<div class="spacer xxx-large show-for-small-only"></div>
<h2>Timeline</h2>
<div class="spacer small"></div>
<a href="/timeline" class="button-default color-main">View All</a>
<div class="spacer x-large"></div>
<div class="articles-container">
  
  {%- for htl in homepage_timeline -%}
  <div class="article-item">
    <div>
      <a href="/timeline/{{ htl.slug }}">
        <h3>{{ htl.title }}</h3>
      </a>
    </div>
    <div class="spacer x-small"></div>
    <div class="publish-info">Published on {{ htl.published_date | strftime: '%b %d, %Y', 'Sydney' }}</div>
  </div>
  {%- endfor -%}  
  
</div>
{%- endif -%}    