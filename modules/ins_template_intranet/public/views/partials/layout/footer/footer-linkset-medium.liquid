---
  metadata: {
    partial_name: "footer-linkset-medium"
  }
---
<div class="grid-x grid-padding-x gutter-medium show-for-medium-only">
  <div class="medium-12 small-12 cell">
    <div class="grid-x">
      <!-- Support -->
      <div class="medium-3">
        <ul class="vertical menu">
          <li>
            <a href="/support" class="navigation-level-1 color-font-head">Support</a>
            <div class="spacer"></div>
          </li>
          {%- for footer_support_item in footer_support_items -%}
          {%- if footer_support_item.parent_category == null -%}
          <li>
            <a href="/support/{{ footer_support_item.slug }}" class="footer-links color-font-head">{{
              footer_support_item.title }}</a>
            <div class="spacer x-small"></div>
          </li>
          {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <!-- Developers -->
      <div class="medium-3">
        <ul class="vertical menu">
          <li>
            <a href="/developers" class="navigation-level-1 color-font-head">Developers</a>
            <div class="spacer"></div>
          </li>
          {%- for footer_developers_item in footer_developers_items -%}
          {%- if footer_developers_item.parent_category == null -%}
          <li>
            <a href="/developers/{{ footer_developers_item.slug }}"
              class="footer-links color-font-head">{{ footer_developers_item.title }}</a>
            <div class="spacer x-small"></div>
          </li>
          {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <!-- Design -->
      <div class="medium-3">
        <ul class="vertical menu">
          <li>
            <a href="/design" class="navigation-level-1 color-font-head">Design</a>
            <div class="spacer"></div>
          </li>
          {%- for footer_design_item in footer_design_items -%}
          {%- if footer_design_item.parent_category == null -%}
          <li>
            <a href="/design/{{ footer_design_item.slug }}" class="footer-links color-font-head">{{
              footer_design_item.title }}</a>
            <div class="spacer x-small"></div>
          </li>
          {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <!-- News, FAQ, Timeline -->
      <div class="medium-3">
        <ul class="vertical menu">
          <li>
            <a href="/news" class="navigation-level-1 color-font-head">News</a>
            <div class="spacer"></div>
          </li>
          <li>
            <a href="faqs" class="navigation-level-1 color-font-head">FAQs</a>
            <div class="spacer"></div>
          </li>
          <li>
            <a href="/timeline" class="navigation-level-1 color-font-head">Timeline</a>
            <div class="spacer"></div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>