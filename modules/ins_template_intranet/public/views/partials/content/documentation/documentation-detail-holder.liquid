---
  metadata: {
    partial_name: "documentation-detail-holder"
  }
---
<div class="app-wrap main-container docu-layout-detail">
  <div class="blocks-sc-2col-04 wrapper bg-color-ui-01">
    <div class="grid-container">
      <div class="grid-x grid-padding-x gutter-medium blog-list align-middle markdown-block" id="dynamic-content-wrapper">
        <div class="large-12 cell">
          {% if item.status == "Published" %}
          <h1 class="title">{{ item.title }}</h1>
          <div class="spacer x-small"></div>
          <p class="published-date">Published on {{ item.published_date }}</p>
          <div class="spacer"></div>
          <div class="content-block-1">
            {{ item.content_block_1 | markdown }}
          </div>
          <div class="spacer"></div>
          <div class="content-block-2">
            {{ item.content_block_2 }}
          </div>
          <div class="spacer xxxx-large"></div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>