---
  metadata: {
    partial_name: "header"
  }
---
<header class="navigation-04 header" data-test="main-header" id="main-header">
  <div class="wrapper">
    <div class="header-top-bar grid-container grid-x align-middle">
      <div class="large-2 medium-3 small-9 cell">
        <a href="/">
          {% if global.company_logo.url != blank %}
            <img class="logo" src="{{ global.company_logo.url }}"
            alt="logo" />
          {% else %}
              <img class="logo" src="{{ 'modules/intranet/images/logo/intranet-logo.png' | asset_url }}" 
              alt="logo" />
          {% endif %}     
        </a>
      </div>
      <div class="large-1 medium-3 small-0"></div>
      <div class="show-for-large large-9 medium-6 small-12 cell text-right">
        <div class="header-links">
          {% include 'modules/intranet/layout/menu_items' %}
        </div>
      </div>
      <div class="hide-for-large mobile-menu-toggle large-0 medium-6 small-3 cell vertical-align-middle align-right">
        <div id="mobile-menu-btn" class="icon-menu-1"></div>
        {% include 'modules/intranet/layout/mobile_menu' %}
      </div>
    </div>
  </div>
</header>

<div id="head-filler">
  <div class="filler show-for-large desktop" style="height:107px;"></div>
  <div class="filler hide-for-large mobile" style="height:99px;"></div>
</div>