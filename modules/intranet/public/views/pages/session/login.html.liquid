{%- include "modules/intranet/data/global_content" -%}
{%- assign global = context.exports.global -%}

<div class="wrapper">
    <div class="login-page grid-container grid-x">
        <div class="spacer xxxx-large"></div>
        <div class="large-4 large-offset-4 medium-6 medium-offset-3 small-12 small-offset-0 cell text-center">
            <img src="{{ context.exports.global.company_logo.url }}" alt="{{ context.exports.global.company_slogan }}" />
        </div>
        <div class="large-4 large-offset-4 medium-6 medium-offset-3 small-12 small-offset-0 cell">
            <div class="spacer xxx-large"></div>
            
            <div class="login-wrap">
                {% include_form 'modules/intranet/login' %}
            </div>
            
        </div>
        <div class="spacer xxxx-large"></div>
    </div>
</div>


{% if context.flash.notice != blank %}
  <span id="message" style="display:none">{{ context.flash.notice }}</span>
  <style>
  /* NOTYF custom CSS */
    .notyf__toast {
        padding-left: 0;
        position: relative;
        background-color: #2c3148 !important;
        box-shadow: -1px 18px 70px rgba(140, 148, 164, 0.75);
    }

    .notyf__toast--upper {
        margin-bottom: 8px;
    }

    .notyf__toast .notyf__wrapper {
        padding: 0;
    }

    .notyf__toast--dismissible .notyf__wrapper {
        padding-right: 25px;
    }

    .notyf__icon {
        margin-right: 0;
        top: 0;
        position: absolute;
        font-size: 17px;
        height: 100%;
        width: initial;
        vertical-align: middle
    }

    .notyf__icon i {
        display: block;
        width: 45px;
        height: 100%;
    }

    .notyf__icon i::before {
        font-family: "insites-20-fonticon" !important;
        position: relative;
        color: #ffffff;
        top: calc(50% - 8px);
    }

    .notyf__icon i.success {
        background-color: #24be8d;
    }

    .notyf__icon i.warning {
        background-color: #ffa639;
    }

    .notyf__icon i.error {
        background-color: #f27474;
    }

    .notyf__icon i.info {
        background-color: #1e86e3;
    }

    .notyf__icon i.info::before {
        display: block;
        -webkit-animation: spin 2s linear infinite;
        -moz-animation: spin 2s linear infinite;
        animation: spin 2s linear infinite;
    }

    .notyf__message {
        padding: 16px 5px;
        margin-left: 50px;
        font-family: "Open Sans", sans-serif;
        line-height: 20px;
        font-size: 14px;
        color: #eee;
        min-width: 210px;
        max-width: 210px;
    }

    .notyf__dismiss .notyf__dismiss-btn {
        background-color: #2c3148;
    }
    /* END NOTYF custom CSS */
  </style>
  <script>
    var message = document.getElementById('message').innerText;
    let notyf = new Notyf(
        {
            duration: 5000,
            position: {
                x: 'right',
                y: 'top',
            },
            types: [
                {
                    type: 'info',
                    background: 'none',
                    dismissible: true,
                    icon: {
                        className: 'icon-settings-1 info',
                        tagName: 'i'
                    }
                },
                {
                    type: 'success',
                    background: 'none',
                    dismissible: true,
                    icon: {
                        className: 'icon-check success',
                        tagName: 'i'
                    }
                },
                {
                    type: 'warning',
                    background: 'none',
                    dismissible: true,
                    icon: {
                        className: 'icon-warning warning',
                        tagName: 'i'
                    }
                },
                {
                    type: 'error',
                    background: 'none',
                    dismissible: true,
                    icon: {
                        className: 'icon-close-1 error',
                        tagName: 'i'
                    }
                }
            ]
        }
    );
    notyf.open({ type: 'success', message });
  </script>
{% endif %} 