---
  metadata: {
    partial_name: "timeline-holder"
  }
---
{%- assign page = context.params.page | default: 1 | plus: 0 -%}
{%- assign per_page = context.params.per_page | default: 10 | plus: 0 -%}
{%- assign tag = context.params.tag | default: "" -%}
{%- assign status = context.params.status | default: "" -%}

<div class="blocks-sc-1col-04 wrapper bg-color-ui-01">
  <div class="spacer section"></div>
  <div class="grid-container">
    <div class="grid-x align-center">
      <div class="large-8 medium-10 small-12 cell">
        <h1>Timeline</h1>
        <div class="spacer xxxx-large"></div>
        <div class="filter-holder">
          {% include 'modules/ins_template_intranet/content/timeline/filter' %}

          {%- assign filters = context.exports.filters -%}

          {%- graphql timeline_items = 'modules/ins_template_intranet/timeline/get_timeline_items',
          page: page,
          size: per_page,
          date_today: date_today,
          range: filters.range,
          tag: tag,
          status: status
          -%}


        </div>
        <div class="spacer"></div>
        <div class="timeline-holder markdown-block" id="dynamic-content-wrapper">
          {%- if timeline_items.items.total_entries != 0 -%}
          {%- comment -%} Has results{%- endcomment -%}
          <ins-timeline static-timeline total-count="4">
            {% for ti in timeline_items.items.results %}
            <!-- item -->
            <ins-timeline-item>
              <div slot="content">
                <div class="tag-date">
                  <ins-tag class="capitalize" font-color="#1e86e3" background-color="#1e86e31a"
                    label="{{ ti.category_tag }}">
                  </ins-tag>
                  <span class="date">
                    {{ ti.published_date }}
                  </span>
                </div>
                <div class="spacer small"></div>
                <h2>{{ ti.title }}</h2>
                <div class="spacer small"></div>
                <div class="timeline-content-block">
                  <ins-markdown
                      value="{{ ti.timeline_content }}">
                  </ins-markdown>
                </div>

                {%- if ti.enable_details_page -%}
                <div class="spacer"></div>
                <a class="read-more" href="/timeline/{{ ti.slug }}">Read More</a>
                {%- endif -%}

              </div>
            </ins-timeline-item>
            <!-- /item -->

            {% endfor %}

          </ins-timeline>
          {%- comment -%} End has results{%- endcomment -%}
          {%- else -%}
          {%- comment -%} No results{%- endcomment -%}
          <p class="no-results-holder">No Results</p>
          {%- comment -%} End no results{%- endcomment -%}
          {%- endif -%}

        </div>
        <div class="spacer xxxx-large"></div>

        <!-- paginations -->
        <div class="pagination-holder">
          {% if timeline_items.items.total_entries > 0 %}
          {%- include 'modules/ins_template_intranet/content/timeline/pagination',
          data: timeline_items -%}
          {% endif %}
        </div>
        <!-- /paginations -->
      </div>
    </div>
  </div>
  <div class="spacer"></div>
</div>

<script>
  let tag = '{{ tag }}';
  let per_page = {{ per_page }};
  let period = '{{ context.params.period }}';
  let range = '{{ context.params.range }}';
  let status = '{{ status }}';

  const dateFilterEl = document.getElementById("dateFilter");
  const tagFilterEl = document.getElementById("tagFilter");
  const statusFilterEl = document.getElementById("statusFilter");

  let goToFilteredUrl = function (per_page, tag, period, range, status) {
    let url = "/timeline"
      + `?page=1&per_page=${per_page}`
      + `&tag=${tag}`
      + `&period=${period}`
      + `&range=${range}`
      + `&status=${status}`;

    window.location.assign(url);
  }

  dateFilterEl.addEventListener('insFilterApply', event => {
    let date = event.detail["Date Period"];
    let range = date === "All" ? "All" : `${date.from},${date.to}`;
    let period = date === "All" ? "All"
      : date.currentFilter.includes("Custom")
        ? "Custom" : date.currentFilter;
    goToFilteredUrl(per_page, tag, period, range, status);
  });

  tagFilterEl.addEventListener('insFilterApply', event => {
    let tag = event.detail['Tag'];
    if (tag === 'All') {
      tag = '';
    }

    goToFilteredUrl(per_page, tag, period, range, status);
  });

  statusFilterEl.addEventListener('insFilterApply', event => {
    let status = event.detail['Status'];
    if (status === 'All') {
      status = '';
    }

    goToFilteredUrl(per_page, tag, period, range, status);
  });

  let pageSizeSelect = document.getElementById("press-page-size-select");
  if (pageSizeSelect) {
    pageSizeSelect.addEventListener('insValueChange', pageSizeValueSelected);
  }

  function pageSizeValueSelected(event) {
    let per_page = event.detail;
    goToFilteredUrl(per_page, tag, period, range, status);
  }

</script>